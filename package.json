{
  "name": "nipscernweb",
  "version": "1.0.0",
  "private": true,
  "description": "NIPS-CERN website (nipscern.com) — static site for GitHub Pages.",
  "scripts": {
    "dev": "node tools/dev-server.js",
    "start": "node tools/dev-server.js",
    "build:min": "node tools/build-min.js",
    "check:min": "node tools/build-min.js --check",
    "test:drawer": "node tools/test-drawer-flash.js",
    "test:sky": "node tools/test-sky-identical.js",
    "test:cgv": "node tools/test-cgv-defer.js",
    "test": "node tools/test-drawer-flash.js && node tools/test-cgv-defer.js && node tools/test-sky-identical.js && node tools/test-icons-complete.js",
    "build:icons": "node tools/build-icon-subsets.js",
    "check:icons": "node tools/build-icon-subsets.js --check",
    "test:icons": "node tools/test-icons-complete.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.0.0"
  }
}
