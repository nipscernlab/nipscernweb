#!/bin/sh
# Auto cache-busting.
#
# Every file the browser caches by URL is listed once, below. When any of them
# is part of a commit, the ?v= token is recomputed from a hash of all of their
# content and rewritten across every tracked HTML page and every module that
# imports one of them. A change therefore always reaches production, because
# the URL changes whenever the content does. Nothing to remember by hand.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip on a given commit: git commit --no-verify

set -e

# ------------------------------------------------------------------
# The list. One place.
#
# It has been wrong three times, and each time the same way: a file was added
# to the site with a ?v= token nobody owned, so its token froze at whatever it
# was born with while the file went on changing. icons.css sat at one token
# through four regenerations, which is why a fixed icon never reached a browser
# that had already cached it. home.js did the same while it was the file under
# the most active work on the site. publications.js and one import of main.js
# carried tokens somebody typed by hand, and the second of those was fetching a
# whole extra copy of main.js under a URL of its own.
#
# It happened a fourth time with the card media, which is why they are here now.
# A video replaced in place under the same name is the purest version of it: one
# was re-encoded to remove a colour cast, the file on disk was grey, and the
# browser went on serving the coloured one it already had. Nothing in the page
# had changed, so nothing told it otherwise.
#
# A file that is not on this list has that bug. That is the only rule.
# ------------------------------------------------------------------
ASSETS="assets/css/main.css
assets/css/icons.css
assets/js/main.js
assets/js/home.js
assets/js/about.js
assets/js/cern.js
assets/js/network.js
assets/js/i18n.js
assets/js/content-links.js
assets/js/smooth-scroll.js
assets/js/motion.js
assets/js/sky.js
assets/js/publications.js
assets/js/hearts.js
assets/js/license.js
assets/js/analytics.js
assets/js/vendor/gsap.min.js
assets/js/vendor/ScrollTrigger.min.js
assets/js/vendor/lenis.mjs
assets/js/vendor/three.module.min.js
assets/js/vendor/three.core.min.js
assets/videos/sapho-circuit-loop.mp4
assets/videos/aurora-borealis-loop.mp4
assets/videos/aurora-borealis-loop-av1.mp4
assets/videos/cgv-geometry-loop.mp4
assets/videos/ai-hand-loop.mp4
assets/videos/about-light-waves-loop.mp4
assets/images/projects/sapho-circuit-poster.webp
assets/images/projects/aurora-borealis-poster.webp
assets/images/projects/cgv-geometry-poster.webp
assets/images/projects/ai-hand-poster.webp
assets/images/about-light-waves-poster.webp
assets/css/main.min.css
assets/css/icons.min.css
assets/js/main.min.js
assets/js/home.min.js
assets/js/about.min.js
assets/js/cern.min.js
assets/js/network.min.js
assets/js/i18n.min.js
assets/js/content-links.min.js
assets/js/smooth-scroll.min.js
assets/js/motion.min.js
assets/js/sky.min.js
assets/js/publications.min.js
assets/js/hearts.min.js
assets/js/license.min.js
assets/js/analytics.min.js
assets/css/icons/404.css
assets/css/icons/about.css
assets/css/icons/cern.css
assets/css/icons/credits.css
assets/css/icons/index.css
assets/css/icons/license.css
assets/css/icons/news-index.css
assets/css/icons/news-post.css
assets/css/icons/pdf-viewer.css
assets/css/icons/privacy.css
assets/css/icons/projects-archived.css
assets/css/icons/projects-aurora.css
assets/css/icons/projects-cgv.css
assets/css/icons/projects-hits.css
assets/css/icons/projects-index.css
assets/css/icons/projects-polaris.css
assets/css/icons/projects-sapho.css
assets/css/icons/projects-yanc.css
assets/css/icons/publications-courier.css
assets/css/icons/publications.css
assets/css/icons/qa.css
assets/css/icons/terms.css"

# The alternation used for rewriting is derived from the list rather than
# written out again, because a second copy of the list is exactly the thing
# that has gone wrong every time.
NAMES=$(printf '%s\n' "$ASSETS" | sed 's#.*/##; s#\.#\\.#g' | tr '\n' '|' | sed 's/|$//')

# Only act when one of them is staged.
PATHS=$(printf '%s\n' "$ASSETS" | sed 's#\.#\\.#g' | tr '\n' '|' | sed 's/|$//')
# HTML também dispara, e tem que disparar.
#
# Os subconjuntos de ícones são derivados do HTML de cada página: quem decide o
# que entra em assets/css/icons/<pagina>.css é o que aquela página escreve. Se o
# gatilho fosse só a lista de assets, acrescentar um <i class="ph ph-cpu"> a uma
# página não regeraria nada, o subconjunto ficaria sem aquele ícone, e o que o
# leitor veria não seria "nada": a regra base é uma máscara sobre currentColor,
# então um --ph que não existe vira um QUADRADO SÓLIDO no lugar do ícone.
changed=$(git diff --cached --name-only | grep -E "^($PATHS)$" || true)
html_changed=$(git diff --cached --name-only | grep -E '\.html$' | grep -v '^kristoffer/' || true)
[ -z "$changed" ] && [ -z "$html_changed" ] && exit 0

# ------------------------------------------------------------------
# As cópias minificadas, geradas antes de qualquer hash.
#
# O que o site serve são os .min. Eles são derivados das fontes e não se editam
# à mão, então quem garante que os dois lados batem é isto aqui e não a memória
# de quem commita: a fonte entrou no commit, a cópia servida entra junto.
#
# Um .min defasado é o mesmo bug que este hook inteiro existe para evitar — o
# navegador servindo uma coisa enquanto o repositório mostra outra — só que pior,
# porque nem o ?v= denuncia: o token muda, o arquivo velho é rebaixado com token
# novo, e a correção continua sem chegar em lugar nenhum.
#
# Falhar é o certo se o esbuild não estiver instalado. Um "pulei a minificação"
# silencioso publica a fonte comentada ou, pior, uma cópia velha.
# ------------------------------------------------------------------
if ! node tools/build-min.js; then
  echo "pre-commit: a minificação falhou. Rode 'npm install' e tente de novo." >&2
  exit 1
fi
for m in $(printf '%s\n' "$ASSETS" | grep -E '\.min\.(css|js)$'); do
  [ -f "$m" ] && git add "$m"
done

# Os subconjuntos de ícones, pela mesma razão e com a mesma severidade. O
# gerador sai com erro se uma página usar uma classe ph-* que a folha não tem,
# o que antes só aparecia na tela, como quadrado.
if ! node tools/build-icon-subsets.js; then
  echo "pre-commit: a geração dos subconjuntos de ícones falhou." >&2
  exit 1
fi
git add assets/css/icons

# Version = short hash of the staged content of every asset, in list order,
# with the tokens themselves blanked out first.
#
# That last part is not tidiness, it is the only thing that makes this converge.
# The modules now carry the token in their own import specifiers, so a module is
# a file whose content contains the hash of its own content: write the token in
# and the hash changes, compute it again and you get a third value, and the
# guard fails for ever on a token that is correct at every step. Hashing what
# the file means rather than which token it happens to be carrying gives a fixed
# point. The guard normalises exactly the same way.
#
# Text and binary are hashed differently, and they have to be. Piping a few
# megabytes of h264 through sed is not portable: sed works a line at a time and
# what it does with bytes that are not text depends on the platform and the
# locale, so the hook on Windows and the guard on Ubuntu computed two different
# numbers from the same commit. A binary asset contributes its object id
# instead, which is forty characters of ASCII, is exactly as sensitive to a
# change in the file, and never enters a pipe that has to behave identically on
# two systems.
ver=$( printf '%s\n' "$ASSETS" | while read -r a; do
         [ -z "$a" ] && continue
         case "$a" in
           *.css|*.js|*.mjs)
             git cat-file blob ":$a" 2>/dev/null | sed -E 's/\?v=[A-Za-z0-9._-]+/?v=/g' ;;
           *)
             git rev-parse ":$a" 2>/dev/null ;;
         esac
       done | git hash-object --stdin | cut -c1-10 )

# Rewrite the token everywhere it appears. HTML because that is where the pages
# reference their assets, and the modules themselves because one module
# importing another is the same cached URL by another name.
#
# kristoffer/ is excluded. It is a personal project that shares the domain and
# nothing else, and it happens to load analytics.js, which was enough to pull it
# into a commit about the laboratory site. That page is not ours to version.
touched=""
for f in $(git ls-files '*.html' 'assets/js/*.js' | grep -v '^kristoffer/'); do
  if grep -qE "($NAMES)\?v=" "$f"; then
    sed -i -E "s#(($NAMES)\?v=)[A-Za-z0-9._-]+#\1${ver}#g" "$f"
    git add "$f"
    touched="${touched} ${f}"
  fi
done

if [ -n "$touched" ]; then
  echo "pre-commit: bumped asset cache version to '${ver}' in:${touched}"
fi
